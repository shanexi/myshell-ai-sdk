{
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "ignore": [
      "**/pnpm-lock.yaml",
      "./dist",
      "./coverage",
      "**/*.typegen.ts",
      "libs/biz/ui/src/components/message-list/**/*",
      "apps/my-app/dist",
      "apps/**/style.css",
      "libs/**/styles.css",
      "libs/agent/ui/output.css",
      "libs/agent/ui/output-prefixed.css",
      "./storybook-static",
      ".yalc"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  }
}
