{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@myshell-run/agent-chat-input-plugins": [
        "libs/agent/chat-input-plugins/src/index.ts"
      ],
      "@myshell-run/agent-message-item-plugins": [
        "libs/agent/message-item-plugins/src/index.ts"
      ],
      "@myshell-run/agent-ui": ["libs/agent/ui/src/index.ts"],
      "@myshell-run/archive-automata": ["libs/archive/automata/src/index.ts"],
      "@myshell-run/archive-chat": ["libs/archive/chat/src/index.ts"],
      "@myshell-run/biz-ac": ["libs/biz/ac/src/index.ts"],
      "@myshell-run/biz-def": ["libs/biz/def/src/index.ts"],
      "@myshell-run/biz-message-item-plugins": [
        "libs/biz/message-item-plugins/src/index.ts"
      ],
      "@myshell-run/biz-service": ["libs/biz/service/src/index.ts"],
      "@myshell-run/biz-ui": ["libs/biz/ui/src/index.ts"],
      "@myshell-run/common-def": ["libs/common/def/src/index.ts"],
      "@myshell-run/common-ui": ["libs/common/ui/src/index.ts"],
      "@myshell-run/effect-demo": ["libs/effect-demo/src/index.ts"],
      "@myshell-run/my-nx-plugins": ["libs/my-nx-plugins/src/index.ts"],
      "@myshell-run/react-aria-tailwind-starter": [
        "libs/react-aria-tailwind-starter/src/index.ts"
      ],
      "@myshell-run/tailwind-cfg/styles-with-no-source.css": [
        "libs/tailwind-cfg/styles-with-no-source.css"
      ],
      "@myshell-run/tailwind-cfg/styles.css": ["libs/tailwind-cfg/styles.css"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "exclude": ["node_modules", "tmp"]
}
