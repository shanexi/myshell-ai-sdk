{
  "name": "common-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/common/ui/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "local-publish": {
      "executor": "@myshell-run/my-nx-plugins:local-publish",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/common/ui",
        "tsConfig": "libs/common/ui/tsconfig.lib.json",
        "assets": [
          {
            "input": "./libs/common/ui/src/remark/hast-util-to-jsx-runtime",
            "glob": "**/*",
            "output": "./src/remark/hast-util-to-jsx-runtime"
          }
        ]
      }
    },
    "build": {
      "executor": "@nrwl/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/common/ui",
        "main": "libs/common/ui/src/index.ts",
        "tsConfig": "libs/common/ui/tsconfig.lib.json",
        "assets": [
          "libs/common/ui/*.md",
          {
            "input": "./libs/common/ui/src/remark/hast-util-to-jsx-runtime",
            "glob": "**/*",
            "output": "./src/remark/hast-util-to-jsx-runtime"
          }
        ]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/common/ui/jest.config.ts",
        "passWithNoTests": true,
        "coverageReporters": ["text"]
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/common/ui/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "storybook": {
      "executor": "@nrwl/storybook:storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/common/ui/.storybook",
        "uiFramework": "@storybook/react"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "./libs/common/ui",
        "command": "../../../node_modules/.bin/test-storybook --url http://localhost:4400"
      }
    },
    "build-storybook": {
      "executor": "@nrwl/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ui-primitives",
        "configDir": "libs/common/ui/.storybook",
        "uiFramework": "@storybook/react"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nrwl/web:file-server",
      "options": {
        "buildTarget": "common-ui:build-storybook",
        "staticFilePath": "dist/storybook/ui-primitives"
      },
      "configurations": {
        "ci": {
          "buildTarget": "common-ui:build-storybook:ci"
        }
      }
    }
  }
}
