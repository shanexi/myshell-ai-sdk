{
  "name": "agent-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/agent/ui/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "local-publish": {
      "executor": "@myshell-run/my-nx-plugins:local-publish",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build-css", "^local-publish"],
      "options": {
        "outputPath": "dist/libs/agent/ui",
        "tsConfig": "libs/agent/ui/tsconfig.lib.json",
        "assets": ["libs/agent/ui/output.css"]
      }
    },
    "build": {
      "executor": "@nrwl/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/agent/ui",
        "main": "libs/agent/ui/src/index.ts",
        "tsConfig": "libs/agent/ui/tsconfig.lib.json",
        "assets": ["libs/agent/ui/output.css"]
      }
    },
    "build-css": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "./libs/agent/ui",
        "command": "../../../node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/styles.css -o output.css"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/agent/ui/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/agent/ui/jest.config.ts",
        "passWithNoTests": true,
        "coverageReporters": ["text"]
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "storybook": {
      "executor": "@nrwl/storybook:storybook",
      "options": {
        "port": 4500,
        "configDir": "libs/agent/ui/.storybook",
        "uiFramework": "@storybook/react"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "./libs/agent/ui",
        "command": "../../../node_modules/.bin/test-storybook --url http://localhost:4400"
      }
    },
    "build-storybook": {
      "executor": "@nrwl/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ui",
        "configDir": "libs/agent/ui/.storybook",
        "uiFramework": "@storybook/react"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nrwl/web:file-server",
      "options": {
        "buildTarget": "agent-ui:build-storybook",
        "staticFilePath": "dist/storybook/ui"
      },
      "configurations": {
        "ci": {
          "buildTarget": "agent-ui:build-storybook:ci"
        }
      }
    }
  }
}
