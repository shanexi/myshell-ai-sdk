{
  "name": "agent-message-plugins",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/agent/message-plugins/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "local-publish": {
      "executor": "@myshell-run/my-nx-plugins:local-publish",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/agent/message-plugins",
        "tsConfig": "libs/agent/message-plugins/tsconfig.lib.json",
        "prefixSelector": ".pf-v6-c-log-viewer",
        "assets": [
          "libs/agent/message-plugins/src/components/simple-log-viewer/simple-log-viewer.css",
          "libs/agent/message-plugins/src/@patternfly/react-core/styles/**/*"
        ]
      }
    },
    "build": {
      "executor": "@nrwl/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/agent/message-plugins",
        "main": "libs/agent/message-plugins/src/index.ts",
        "tsConfig": "libs/agent/message-plugins/tsconfig.lib.json",
        "assets": [
          "libs/agent/message-plugins/src/components/simple-log-viewer/simple-log-viewer.css",
          "libs/agent/message-plugins/src/@patternfly/react-core/styles/**/*"
        ]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/agent/message-plugins/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "storybook": {
      "executor": "@nrwl/storybook:storybook",
      "options": {
        "port": 4510,
        "configDir": "libs/agent/message-plugins/.storybook",
        "uiFramework": "@storybook/react"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "./libs/agent/message-plugins",
        "command": "../../../node_modules/.bin/test-storybook --url http://localhost:4400"
      }
    },
    "build-storybook": {
      "executor": "@nrwl/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/message-plugins",
        "configDir": "libs/agent/message-plugins/.storybook",
        "uiFramework": "@storybook/react"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nrwl/web:file-server",
      "options": {
        "buildTarget": "agent-message-plugins:build-storybook",
        "staticFilePath": "dist/storybook/message-plugins"
      },
      "configurations": {
        "ci": {
          "buildTarget": "agent-message-plugins:build-storybook:ci"
        }
      }
    }
  }
}
