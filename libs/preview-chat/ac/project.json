{
  "name": "preview-chat-ac",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/preview-chat/ac/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "local-publish": {
      "executor": "@myshell-run/my-nx-plugins:local-publish",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^local-publish"],
      "options": {
        "outputPath": "dist/libs/preview-chat/ac",
        "tsConfig": "libs/preview-chat/ac/tsconfig.lib.json",
        "assets": ["libs/preview-chat/ac/**/*.svg"]
      }
    },
    "build": {
      "executor": "@nrwl/js:tsc",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build"],
      "options": {
        "outputPath": "dist/libs/preview-chat/ac",
        "main": "libs/preview-chat/ac/src/index.ts",
        "tsConfig": "libs/preview-chat/ac/tsconfig.lib.json",
        "assets": ["libs/preview-chat/ac/**/*.svg"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/preview-chat/ac/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/preview-chat/ac/jest.config.ts",
        "passWithNoTests": true,
        "coverageReporters": ["text"]
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "storybook": {
      "executor": "@nrwl/storybook:storybook",
      "options": {
        "port": 4800,
        "configDir": "libs/preview-chat/ac/.storybook",
        "uiFramework": "@storybook/react"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "./libs/preview-chat/ac",
        "command": "../../../node_modules/.bin/test-storybook --url http://localhost:4800"
      }
    },
    "build-storybook": {
      "executor": "@nrwl/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ac",
        "configDir": "libs/preview-chat/ac/.storybook",
        "uiFramework": "@storybook/react"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nrwl/web:file-server",
      "options": {
        "buildTarget": "preview-chat-ac:build-storybook",
        "staticFilePath": "dist/storybook/ac"
      },
      "configurations": {
        "ci": {
          "buildTarget": "preview-chat-ac:build-storybook:ci"
        }
      }
    }
  }
}
