{
  "name": "bot-list",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bot-list/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "compiler": "babel",
        "outputPath": "dist/apps/bot-list",
        "index": "apps/bot-list/src/index.html",
        "baseHref": "/",
        "main": "apps/bot-list/src/main.tsx",
        "tsConfig": "apps/bot-list/tsconfig.app.json",
        "assets": ["apps/bot-list/src/favicon.ico", "apps/bot-list/src/assets"],
        "styles": ["apps/bot-list/src/styles.css"],
        "scripts": [],
        "isolatedConfig": true,
        "webpackConfig": "apps/bot-list/webpack.config.js"
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true,
          "vendorChunk": true
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/bot-list/src/environments/environment.ts",
              "with": "apps/bot-list/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": false
        }
      }
    },
    "serve": {
      "executor": "@nrwl/webpack:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "bot-list:build",
        "hmr": true
      },
      "configurations": {
        "development": {
          "buildTarget": "bot-list:build:development"
        },
        "production": {
          "buildTarget": "bot-list:build:production",
          "hmr": false
        }
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/bot-list/**/*.{ts,tsx,js,jsx}"]
      }
    }
  },
  "tags": []
}
